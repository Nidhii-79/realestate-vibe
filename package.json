{
  "name": "realestate-vibe",
  "version": "1.0.0",
  "private": true,
  "description": "Real Estate Listing Recommender with Vibe Search (PostgreSQL + pgvector, Next.js)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:init": "node --env-file=.env.local scripts/init-db.js",
    "db:seed": "node --env-file=.env.local scripts/seed.js",
    "db:embed": "node --env-file=.env.local scripts/embed-all.js",
    "setup": "npm run db:init && npm run db:seed && npm run db:embed",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "next": "14.2.35",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
