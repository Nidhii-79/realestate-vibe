# Copy to .env.local and edit. NEVER commit .env.local
DATABASE_URL=postgres://postgres:secret@localhost:5432/realestate
JWT_SECRET=change-this-to-a-long-random-string
# minilm = real semantic embeddings (downloads ~25MB model on first run)
# hash   = offline fallback (bag-of-words hashing), use only if the model download is blocked
EMBED_PROVIDER=minilm
